CONFIG_ARM=y
CONFIG_POSITION_INDEPENDENT=y
CONFIG_ARCH_BCM283X=y
CONFIG_TARGET_RPI_ARM64=y
CONFIG_CMD_BOOTCIRCLE=y
CONFIG_NR_DRAM_BANKS=8
CONFIG_ENV_SIZE=0x4000
CONFIG_DEFAULT_DEVICE_TREE="bcm2711-rpi-4-b"
CONFIG_OF_LIBFDT_OVERLAY=y
CONFIG_DM_RESET=y
CONFIG_SYS_LOAD_ADDR=0x1000000
CONFIG_PCI=y
CONFIG_EFI_RUNTIME_UPDATE_CAPSULE=y
CONFIG_EFI_CAPSULE_FIRMWARE_RAW=y
CONFIG_EFI_HTTP_BOOT=y
CONFIG_BOOTSTD_DEFAULTS=y
CONFIG_OF_BOARD_SETUP=y
CONFIG_FDT_SIMPLEFB=y
CONFIG_BOOTCOMMAND="run circle_boot"
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="run circle_preboot"
CONFIG_SYS_PBSIZE=1049
# CONFIG_DISPLAY_CPUINFO is not set
# CONFIG_DISPLAY_BOARDINFO is not set
CONFIG_MISC_INIT_R=y
CONFIG_SYS_PROMPT="U-Boot> "
CONFIG_CMD_NVEDIT_EFI=y
CONFIG_CMD_GPIO=y
CONFIG_CMD_MMC=y
CONFIG_CMD_PCI=y
CONFIG_CMD_USB=y
CONFIG_CMD_SNTP=y
CONFIG_CMD_EFIDEBUG=y
CONFIG_CMD_FS_UUID=y
CONFIG_ENV_FAT_DEVICE_AND_PART="0:1"
CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG=y

# Deliberately no CONFIG_NET_LWIP: NETCONSOLE lives inside "if NET_LEGACY"
# in net/Kconfig, so the network console is not even selectable on the lwIP
# stack.  NET_LEGACY is the default arm of that choice, which is why there
# is no CONFIG_NET_LEGACY=y line here - no defconfig in the tree writes one.
# The one thing lost with lwIP is CONFIG_WGET_HTTPS (it depends on
# PROT_TCP_LWIP); plain wget and EFI HTTP boot still work.

CONFIG_DM_DMA=y
CONFIG_DFU_MMC=y
CONFIG_SYS_DFU_DATA_BUF_SIZE=0x100000
CONFIG_SYS_DFU_MAX_FILE_SIZE=0x200000
CONFIG_BCM2835_GPIO=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_SDMA=y
CONFIG_MMC_SDHCI_BCM2835=y
CONFIG_MMC_SDHCI_BCMSTB=y
CONFIG_BCMGENET=y
CONFIG_PCI_BRCMSTB=y
CONFIG_PINCTRL=y
# CONFIG_PINCTRL_GENERIC is not set
CONFIG_RESET_BRCMSTB=y
CONFIG_RESET_BRCMSTB_RESCAL=y
CONFIG_DM_RNG=y
CONFIG_RNG_IPROC200=y
# CONFIG_REQUIRE_SERIAL_CONSOLE is not set
CONFIG_SYSINFO=y
CONFIG_SYSINFO_SMBIOS=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_DWC2=y
CONFIG_USB_KEYBOARD=y
CONFIG_USB_HOST_ETHER=y
CONFIG_USB_ETHER_LAN78XX=y
CONFIG_USB_ETHER_SMSC95XX=y
# Realtek RTL8152B/RTL8153A/RTL8153B, the usual USB gigabit dongle.
CONFIG_USB_ETHER_RTL8152=y
CONFIG_VIDEO=y
# CONFIG_VIDEO_BPP8 is not set
# CONFIG_VIDEO_BPP16 is not set
CONFIG_SYS_WHITE_ON_BLACK=y
CONFIG_VIDEO_BCM2835=y
CONFIG_CONSOLE_SCROLL_LINES=10
CONFIG_PHYS_TO_BUS=y
CONFIG_MBEDTLS_LIB=y
# CONFIG_HEXDUMP is not set

# fatload is what circle_load uses; do not let it depend on BOOTSTD_DEFAULTS
CONFIG_CMD_FAT=y
CONFIG_FS_FAT=y

# Autoboot Circle, but leave time to interrupt and get a prompt
CONFIG_BOOTDELAY=2
CONFIG_USE_BOOTCOMMAND=y

# Circle owns the secondary cores: U-Boot must not start them, or Circle's
# PSCI CPU_ON returns ALREADY_ON (-4) and multicore support fails.  Keeping
# ARMV8_MULTIENTRY off also keeps ARMV8_SPIN_TABLE unreachable.
# CONFIG_ARMV8_MULTIENTRY is not set
# CONFIG_ARMV8_PSCI is not set

# Raspberry Pi 5 Ethernet, for TFTP-loading Circle images.
# The MAC is a Cadence GEM inside the RP1 southbridge, which hangs off
# PCIe, so the whole chain has to be enabled: PCIe root complex, the RP1
# endpoint, RP1 clocks and GPIO (the PHY reset line), then macb.
CONFIG_BCM2712=y
CONFIG_BOARD_LATE_INIT=y
CONFIG_BOARD_TYPES=y
CONFIG_PCI_PNP=y
CONFIG_MFD_RP1=y
CONFIG_CLK=y
CONFIG_CLK_RP1=y
CONFIG_RP1_GPIO=y
CONFIG_RESET_RASPBERRYPI=y
CONFIG_MACB=y
CONFIG_PHY_BROADCOM=y

# Network commands for TFTP boot
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_TFTP_TSIZE=y
CONFIG_BOOTP_SEND_HOSTNAME=y

# USB on the Raspberry Pi 5 is also behind the RP1: two DesignWare USB3
# controllers ("snps,dwc3") on the same PCIe-endpoint bus as the GEM, both
# marked okay by the firmware device tree.  xhci-dwc3 needs nothing else -
# its reset, clock and PHY setup are all optional - and it gives a USB
# Ethernet adapter somewhere to attach.  USB_XHCI_PCI stays for an xHCI
# card in the M.2 slot.
CONFIG_USB_XHCI_DWC3=y

# Network console.  Requires the legacy stack; see the note above.
CONFIG_NETCONSOLE=y

# The storage loader web UI: a browser writes a file to the SD card.
# CONFIG_HTTPD selects PROT_TCP, the legacy stack's TCP implementation.
CONFIG_HTTPD=y
CONFIG_CMD_HTTPD=y

# ARCH_BCM283X already implies FAT_WRITE, so "make savedefconfig" drops this
# line - but the loader cannot write anything without it, which is the same
# reason CONFIG_CMD_FAT is spelled out above.
CONFIG_FAT_WRITE=y

# "clk dump" is step 3 of the Ethernet bring-up procedure in
# doc/board/broadcom/raspberrypi-circle-net.rst, but CMD_CLK was never
# enabled, so it failed as an unknown command.  (dm tree and mdio list, the
# other two, already come in implicitly - CMD_DM defaults on and
# BOOTSTD_DEFAULTS pulls CMD_MII, which implies CMD_MDIO.)
CONFIG_CMD_CLK=y
